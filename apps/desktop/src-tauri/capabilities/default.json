{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Window and event APIs only. No frontend shell or filesystem access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "updater:default",
    "process:allow-restart"
  ]
}
