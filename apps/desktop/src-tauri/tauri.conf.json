{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forma",
  "version": "1.2.1",
  "identifier": "studio.forma.cad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forma",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#151719"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A local CAD workspace with AI-assisted parametric modeling",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "allowDowngrades": true
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/lovlyDev/FormaCAD/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRTJBQ0UzREI2REJEMkQKUldRdHZXM2I0NnppS3ZFaW1DNUswVGd5TDVzYXhpRHJxUmlERXhKTjNRVU9XVWwxUW02Y0NXQ00K"
    }
  }
}
