diff --git a/apps/desktop/src-tauri/src/native/assets/stage.rs b/apps/desktop/src-tauri/src/native/assets/stage.rs
index 5958868..379491e 100644
--- a/apps/desktop/src-tauri/src/native/assets/stage.rs
