+        &f.windows,
+        "window",
+        &receipt.id,
+        true,
+        Source {
+            commit_id: first.commit_id().into(),
+            ..f.source()
+        },
+    )
+    .await
+    .unwrap();
+    let approved = f
+        .windows
+        .consume_write(
+            &receipt.id,
