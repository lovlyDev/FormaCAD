+    inspect(&f, &redo, 80., &executable).await;
+    assert!(tasks.lock().await.is_empty());
+    assert!(gate.status().unwrap().is_empty());
+    let count: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM projects")
+        .fetch_one(&f.pool)
