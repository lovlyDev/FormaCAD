+  expect(mock.execute).toHaveBeenCalledExactlyOnceWith(f.ticket, "undo");
+  expect(confirm).toHaveBeenCalledTimes(requiresConfirmation ? 1 : 0);
+  expect(mock.resolve).toHaveBeenCalledTimes(requiresConfirmation ? 1 : 0);
