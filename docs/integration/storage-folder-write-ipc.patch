+use super::*;
+use serde_json::{json, Value};
+
+fn request(source_id: String) -> Value {
+    json!({
+        "sourceId": source_id,
+        "expectedCommitId": uuid::Uuid::new_v4().to_string(),
+        "approvalId": uuid::Uuid::new_v4().to_string()
+    })
+}
+
+#[test]
+fn folder_write_requires_all_selectors_and_excludes_managed_payload() {
+    let project_id = uuid::Uuid::new_v4().to_string();
+    let valid = request(format!(
+        "{}:1:{}",
+        uuid::Uuid::new_v4(),
+        uuid::Uuid::new_v4()
+    ));
+    let decoded: FolderWriteRequest = serde_json::from_value(valid.clone()).unwrap();
+    assert!(decoded.validate(&project_id, false).is_ok());
+    assert!(decoded.validate(&project_id, true).is_err());
+    assert!(decoded.validate("invalid project", false).is_err());
+
+    for key in ["sourceId", "expectedCommitId", "approvalId"] {
+        let mut missing = valid.clone();
+        missing.as_object_mut().unwrap().remove(key);
+        assert!(serde_json::from_value::<FolderWriteRequest>(missing).is_err());
+
+        let mut invalid = valid.clone();
+        invalid[key] = json!("");
+        let decoded: FolderWriteRequest = serde_json::from_value(invalid).unwrap();
+        assert!(decoded.validate(&project_id, false).is_err());
+    }
+
+    let mut replacement = valid;
+    replacement["program"] = json!("replacement program");
+    assert!(serde_json::from_value::<FolderWriteRequest>(replacement).is_err());
+}
+
+#[cfg(any(
+    windows,
+    all(
+        target_os = "linux",
+        any(target_arch = "x86_64", target_arch = "aarch64")
+    )
+))]
+#[tokio::test]
+async fn folder_write_accepts_the_key_issued_by_the_registry() {
+    use crate::project_repository::sqlite_folder::api::{
+        FolderProject, FolderSources, Publication,
+    };
+    let root = tempfile::tempdir().unwrap();
+    let project = fixture_project();
+    let project_id = project.id.clone();
+    assert!(matches!(
+        FolderProject::create(root.path(), project, vec![], None)
+            .await
+            .unwrap(),
+        Publication::Committed(_)
+    ));
+    let registry = FolderSources::default();
+    let opened = registry.open(root.path()).await.unwrap();
+    let mut payload = request(opened.id.to_string());
+    payload["expectedCommitId"] = json!(opened.snapshot.commit_id());
+    let decoded: FolderWriteRequest = serde_json::from_value(payload).unwrap();
+    decoded.validate(&project_id, false).unwrap();
+    assert!(registry.lookup(&decoded.source_id).is_ok());
+}
+
+#[test]
+fn managed_reply_keeps_the_existing_project_json_shape() {
+    let project = fixture_project();
+    let expected = serde_json::to_value(&project).unwrap();
+    assert_eq!(
+        serde_json::to_value(WriteReply::from(project)).unwrap(),
+        expected
+    );
+}
+
+fn fixture_project() -> Project {
+    serde_json::from_value(json!({
+        "schemaVersion": 1, "id": uuid::Uuid::new_v4().to_string(),
+        "name": "Managed", "units": "mm", "agent": "codex", "pinned": false,
+        "createdAt": "2026-11-20T00:00:00Z", "updatedAt": "2026-11-20T00:00:00Z",
+        "currentRevision": null, "messages": [], "exports": [], "files": [], "revisions": []
+    }))
+    .unwrap()
+}
diff --git a/apps/desktop/src/features/project-sources/writeApi.ts b/apps/desktop/src/features/project-sources/writeApi.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/features/project-sources/writeApi.ts
@@ -0,0 +1,82 @@
+import { invoke, isTauri } from "@tauri-apps/api/core";
+import { z } from "zod";
+import type { Project } from "../../types";
+import {
+  capturePermissionContext,
+  type FolderPermissionTicket,
+} from "./permissionContract";
+
+const commands = {
+  program: "apply_program",
+  commands: "apply_ir_commands",
+  undo: "undo_model",
+  redo: "redo_model",
+} as const;
+
+export type FolderWriteCommand = keyof typeof commands;
+
+const id = z.string().uuid();
+const sourceKey = z.string().min(1).max(128);
+const envelope = { sourceId: sourceKey, projectId: id, baseCommitId: id };
+// The host validates persisted Project data. Check the outer shape and identity
+// here without parsing or copying the full history and attachment payload.
+const list = z.custom<unknown[]>(Array.isArray);
+const projectShape = z.object({
+  schemaVersion: z.literal(1),
+  id,
+  name: z.string(),
+  units: z.enum(["mm", "cm", "inch"]),
+  agent: z.enum(["codex", "claude", "custom"]),
+  pinned: z.boolean(),
+  createdAt: z.string(),
+  updatedAt: z.string(),
+  currentRevision: z.string().nullable(),
+  revisions: list,
+  messages: list,
+  files: list,
+  exports: list,
+});
+const project = z.custom<Project>((value) => projectShape.safeParse(value).success);
+const reply = z.discriminatedUnion("status", [
+  z.strictObject({ ...envelope, status: z.literal("noOp"), project }),
+  z.strictObject({ ...envelope, status: z.literal("committed"), commitId: id, project }),
+  z.strictObject({ ...envelope, status: z.literal("rejectedBefore"), error: z.string() }),
+  z.strictObject({ ...envelope, status: z.literal("indeterminate"), commitId: id, error: z.string() }),
+]);
+
+export type FolderWriteResult = z.infer<typeof reply>;
+
+export async function executeFolderWrite(
+  ticket: FolderPermissionTicket,
+  command: FolderWriteCommand,
+): Promise<FolderWriteResult> {
+  if (!isTauri()) throw new Error("PROJECT_FOLDER_UNSUPPORTED");
+  const { projectId, source } = capturePermissionContext(ticket);
+  const approvalId = ticket.id;
+  if (
+    !sourceKey.safeParse(source.sourceId).success
+    || ![projectId, source.commitId, approvalId].every((value) => id.safeParse(value).success)
+  ) {
+    throw new Error("PROJECT_SNAPSHOT_CHANGED");
+  }
+  const result = reply.safeParse(await invoke<unknown>(commands[command], {
+    projectId,
+    folderWrite: {
+      sourceId: source.sourceId,
+      expectedCommitId: source.commitId,
+      approvalId,
+    },
+  }));
+  if (!result.success) throw new Error("PROJECT_SNAPSHOT_CHANGED");
+  const value = result.data;
+  if (
+    value.projectId !== projectId
+    || value.sourceId !== source.sourceId
+    || value.baseCommitId !== source.commitId
+    || ("project" in value && value.project.id !== projectId)
+    || ("commitId" in value && value.commitId === source.commitId)
+  ) {
+    throw new Error("PROJECT_SNAPSHOT_CHANGED");
+  }
+  return value;
+}
