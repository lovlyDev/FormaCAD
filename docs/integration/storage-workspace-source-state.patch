+import type {ProjectFile} from "../types";
+export async function loadModel(
+  file: ProjectFile,
+  projectId?: string,
+  source?: FolderSourceRef,
+): Promise<THREE.Group> {
+  file={...file};
+  if(source){
+    if(!native)throw new Error("PROJECT_FOLDER_UNSUPPORTED");
+    if(!projectId)throw new Error("PROJECT_SNAPSHOT_CHANGED");
